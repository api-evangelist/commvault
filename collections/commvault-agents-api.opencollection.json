{
  "opencollection": "1.0.0",
  "info": {
    "name": "Commvault Automation Agents API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authtoken",
      "value": "{{Authtoken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Agents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Commvault List agents for a client",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{webserver}/webconsole/api/Agent",
            "params": [
              {
                "name": "clientId",
                "value": "",
                "type": "query",
                "description": "Client ID to list agents for"
              }
            ]
          },
          "docs": "Retrieves a list of all agents (iDataAgents) installed on a specific client. Agents represent the backup module for a particular application type (File System, SQL, Exchange, etc.)."
        }
      ]
    }
  ],
  "bundled": true
}
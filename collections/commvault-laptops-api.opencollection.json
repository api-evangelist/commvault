{
  "opencollection": "1.0.0",
  "info": {
    "name": "Commvault Automation Agents Laptops API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authtoken",
      "value": "{{Authtoken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Laptops",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Commvault List laptop clients",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{webserver}/webconsole/api/Laptop"
          },
          "docs": "Retrieves a list of all laptop clients enrolled for endpoint backup, including their protection status, last backup time, and data usage."
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "Commvault Automation Agents Alerts API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authtoken",
      "value": "{{Authtoken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Alerts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Commvault List alert rules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{webserver}/webconsole/api/AlertRule"
          },
          "docs": "Retrieves a list of configured alert rules. Alerts notify administrators of important events such as job failures, storage thresholds, and security events."
        }
      ]
    }
  ],
  "bundled": true
}
      "item": [
        {
          "id": "3075ae71-fd17-49f9-9692-a15fa1cb23a0",
          "name": "Commvault Authenticate and obtain auth token",
          "request": {
            "name": "Commvault Authenticate and obtain auth token",
            "description": {
              "content": "Authenticates a user with username and password credentials and returns an authentication token (QSDK token) for subsequent API requests. The token must be included in the Authtoken header of all subsequent requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Hostname of the Commvault Web Server",
                  "type": "any",
                  "value": "{{webserver}}",
                  "key": "webserver"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"<string>\",\n  \"password\": \"<password>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "14870f4f-61a7-4a0e-a3e6-30509cd73437",
              "name": "Authentication successful",
              "originalRequest": {
                "url": {
                  "path": [
                    "Login"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "Hostname of the Commvault Web Server",
                      "type": "any",
                      "value": "{{webserver}}",
                      "key": "webserver"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "Authtoken",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {

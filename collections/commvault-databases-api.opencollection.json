{
  "opencollection": "1.0.0",
  "info": {
    "name": "Commvault Automation Agents Databases API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authtoken",
      "value": "{{Authtoken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Databases",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Commvault List database servers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{webserver}/webconsole/api/V4/DatabaseServers"
          },
          "docs": "Retrieves a list of all database servers configured for backup, including SQL Server, Oracle, SAP HANA, and other database platforms."
        }
      ]
    }
  ],
  "bundled": true
}